# Copy to .env and fill in what you need. Every variable is optional.
# .env is git-ignored: never commit real keys.
# Variables already set in your shell take precedence over this file.

# --- LLM (set one key; without a key the app answers in extractive mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# auto = Anthropic if its key is set, else OpenAI | openai | anthropic
HANDBOOK_LLM_PROVIDER=auto
HANDBOOK_OPENAI_MODEL=gpt-5.5
HANDBOOK_LLM_MODEL=claude-opus-5-5
# low | medium | high
HANDBOOK_LLM_EFFORT=medium
# auto | llm | extractive
HANDBOOK_ANSWER_MODE=auto

# --- Search ---
# Embedding model: "fastembed:<model>" or "model2vec:<model>"
HANDBOOK_DENSE_MODEL=fastembed:BAAI/bge-small-en-v1.5
# 1 = dense (vector) search on, 0 = BM25 only
HANDBOOK_DENSE=1
# Cross-encoder re-ranking of the top candidates (1 = on, 0 = off)
HANDBOOK_RERANK=0
# MiniLM-L6 (~90 MB) matched bge-reranker-base (~1 GB) at 4x the speed in our ablation
HANDBOOK_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Vector database (docker compose up -d) ---
# auto = Qdrant if reachable, else in memory | qdrant | memory
HANDBOOK_VECTOR_STORE=auto
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=handbook_chunks

# --- Data ---
# HANDBOOK_CORPUS_DIR=data/corpus
# HANDBOOK_UPLOADS_DIR=data/uploads
# Pin "today" for lifecycle decisions (YYYY-MM-DD); defaults to the real date
# HANDBOOK_TODAY=2026-11-14
